def chv22 (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (ev22 i)) :=
  Fin.cases (Rv21 R) (Fin.cases (R1 R) (fun _ => (R1 R)))

/-- Node `v22`. -/
def Rv22 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 233) :=
  Realisation.multiSubst ev22 (chv22 R) Sb

/-- The seven sizes at node `v22`. -/
def wv22 : Letter → Nat
  | .B => 
  | .N => 
  | .A => 
  | .D => 
  | .O => 0
  | .H => 
  | .V => 

/-- Node `v22` has the sizes `wv22`. -/
lemma stepv22 (R : Realisation Letter Letter.sep G) (h : ∀ a, R.w a = w0 a) :
    ∀ a, (Rv22 R).w a = wv22 a := by
  intro a
  change (Realisation.multiSubst ev22 (chv22 R) Sb).w a = wv22 a
  rw [w_multiSubst]
  have h0 : ∀ b, (chv22 R 0).w b = wv21 b := fun b => stepv21 R h b
  have h1 : ∀ b, (chv22 R 1).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  have h2 : ∀ b, (chv22 R 2).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  simp only [Fin.prod_univ_three, h0, h1, h2]
  cases a <;> native_decide

/-! ### The bound -/

/-- The exponents of the 4 terminal children. -/
def eT : Fin 4 → Nat := Fin.cases 233 (Fin.cases 225 (Fin.cases 225 (fun _ => 233)))

/-- The terminal children. -/
def terminalChildren (R : Realisation Letter Letter.sep G) :
    (i : Fin 4) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (eT i)) :=
  Fin.cases (Rv12 R) (Fin.cases (Rv16 R) (Fin.cases (Rv16 R) (fun _ => (Rv22 R))))

/-- **The bound.**  A port system whose seven families have the sizes of `w0` gives an
independent set of size `M` in `G^(box 916)`. -/
theorem bound (S : RichPortSystem G) (hw : ∀ a, (S.fam a).card = w0 a) :
    M ≤ (SimpleGraph.strongPower G 916).indepNum := by
  have base_w : ∀ a, S.toRealisation.w a = w0 a := hw
  refine le_trans (le_of_eq ?_) (le_indepNum_multiCode eT (terminalChildren S.toRealisation) K)
  have h0 : ∀ a, (terminalChildren S.toRealisation 0).w a = wv12 a := by
    intro a; change (Rv12 S.toRealisation).w a = wv12 a; exact stepv12 S.toRealisation base_w a
  have h1 : ∀ a, (terminalChildren S.toRealisation 1).w a = wv16 a := by
    intro a; change (Rv16 S.toRealisation).w a = wv16 a; exact stepv16 S.toRealisation base_w a
  have h2 : ∀ a, (terminalChildren S.toRealisation 2).w a = wv16 a := by
    intro a; change (Rv16 S.toRealisation).w a = wv16 a; exact stepv16 S.toRealisation base_w a
  have h3 : ∀ a, (terminalChildren S.toRealisation 3).w a = wv22 a := by
    intro a; change (Rv22 S.toRealisation).w a = wv22 a; exact stepv22 S.toRealisation base_w a
  simp only [Fin.prod_univ_four, h0, h1, h2, h3]
  native_decide

end CertC15
end ShannonBounds
