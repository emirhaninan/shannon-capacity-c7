/-!
# `Theta (C15) >= 7.301628695930103`, a weighted schedule

Twenty-three nodes built from the three arity-`3` substitutions `Sa`, `Sb` and `Sc`, ending
in the `57`-word terminal code `K` applied to the four nodes `(v12, v16, v16, v22)` at exponents
`(233, 225, 225, 233)`, so `E = 916`.  The base lives in `C15^(box 4)`, hence
`C15^(box 3664)`.

The bare exponent-`1` base occurs as an interior child -- the middle child of `v7`, and the
tails `v10`-`v12`, `v14`-`v16`, `v20`-`v22` -- and the terminal code is applied to nodes of
different exponents.
-/
namespace ShannonBounds
namespace CertC15

open SimpleGraph

/-- An arity-`3` substitution. -/
abbrev Sa : Subst Letter Letter.sep 3 := Substitutions.S3e

/-- An arity-`3` substitution. -/
abbrev Sb : Subst Letter Letter.sep 3 := Substitutions.S3f

/-- An arity-`3` substitution. -/
abbrev Sc : Subst Letter Letter.sep 3 := Substitutions.S3g

/-- The `57`-word terminal code. -/
abbrev K : Code Letter Letter.sep 4 := TerminalCodes.K4b

/-- The size of each of the seven families of the base port system. -/
def w0 : Letter → Nat
  | .B => 2839
  | .N => 2833
  | .A => 6
  | .D => 3
  | .O => 3
  | .H => 3
  | .V => 3

/-- The size of the independent set the construction produces. -/
def M : Nat :=
  

variable {α : Type*} [Fintype α] [DecidableEq α]
  {G : SimpleGraph α} [DecidableRel G.Adj]

/-- The base realisation, seen in the first strong power. -/
def R1 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 1) :=
  R.mapIso (strongPower_one_iso G).symm

lemma w_R1 (R : Realisation Letter Letter.sep G) (a : Letter) :
    (R1 R).w a = R.w a := by simp [R1]

/-! ### Node `v0`, exponent `3` -/

/-- The child exponents of node `v0`. -/
def ev0 : Fin 3 → Nat := Fin.cases 1 (Fin.cases 1 (fun _ => 1))

/-- The children of node `v0`. -/
def chv0 (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (ev0 i)) :=
  Fin.cases (R1 R) (Fin.cases (R1 R) (fun _ => (R1 R)))

/-- Node `v0`. -/
def Rv0 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 3) :=
  Realisation.multiSubst ev0 (chv0 R) Sb

/-- The seven sizes at node `v0`. -/
def wv0 : Letter → Nat
  | .B => 22882422088
  | .N => 22737675268
  | .A => 144721296
  | .D => 72335151
  | .O => 0
  | .H => 72335151
  | .V => 72386145

/-- Node `v0` has the sizes `wv0`. -/
lemma stepv0 (R : Realisation Letter Letter.sep G) (h : ∀ a, R.w a = w0 a) :
    ∀ a, (Rv0 R).w a = wv0 a := by
  intro a
  change (Realisation.multiSubst ev0 (chv0 R) Sb).w a = wv0 a
  rw [w_multiSubst]
  have h0 : ∀ b, (chv0 R 0).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  have h1 : ∀ b, (chv0 R 1).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  have h2 : ∀ b, (chv0 R 2).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  simp only [Fin.prod_univ_three, h0, h1, h2]
  cases a <;> native_decide

