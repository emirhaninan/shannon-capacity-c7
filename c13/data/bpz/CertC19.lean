/-!
# `Theta (C19) >= 9.357200030000796`, a weighted schedule

Sixteen nodes built from the three arity-`3` substitutions `Sa`, `Sb` and `Sc`, ending in the
`57`-word terminal code `K` applied to four copies of the exponent-`741` node,
so `E = 2964`.  The base lives in `C19^(box 4)`, hence `C19^(box 11856)`.

The bare exponent-`1` base occurs as an interior child: the tail `u10`-`u15` raises the
exponent from `729` to `741` two at a time.
-/
namespace ShannonBounds
namespace CertC19

open SimpleGraph

/-- An arity-`3` substitution. -/
abbrev Sa : Subst Letter Letter.sep 3 := Substitutions.S3f

/-- An arity-`3` substitution. -/
abbrev Sb : Subst Letter Letter.sep 3 := Substitutions.S3g

/-- An arity-`3` substitution. -/
abbrev Sc : Subst Letter Letter.sep 3 := Substitutions.S3d

/-- The `57`-word terminal code. -/
abbrev K : Code Letter Letter.sep 4 := TerminalCodes.K4b

/-- The size of each of the seven families of the base port system. -/
def w0 : Letter → Nat
  | .B => 7664
  | .N => 7661
  | .A => 3
  | .D => 2
  | .O => 2
  | .H => 2
  | .V => 2

/-- The size of the independent set the construction produces. -/
def M : Nat :=
  

variable {α : Type*} [Fintype α] [DecidableEq α]
  {G : SimpleGraph α} [DecidableRel G.Adj]

/-- The base realisation, seen in the first strong power. -/
def R1 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 1) :=
  R.mapIso (strongPower_one_iso G).symm

lemma w_R1 (R : Realisation Letter Letter.sep G) (a : Letter) :
    (R1 R).w a = R.w a := by simp [R1]

/-! ### Node `u0`, exponent `3` -/

/-- The child exponents of node `u0`. -/
def eu0 : Fin 3 → Nat := Fin.cases 1 (Fin.cases 1 (fun _ => 1))

/-- The children of node `u0`. -/
def chu0 (R : Realisation Letter Letter.sep G) :
    (i : Fin 3) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (eu0 i)) :=
  Fin.cases (R1 R) (Fin.cases (R1 R) (fun _ => (R1 R)))

/-- Node `u0`. -/
def Ru0 (R : Realisation Letter Letter.sep G) :
    Realisation Letter Letter.sep (SimpleGraph.strongPower G 3) :=
  Realisation.multiSubst eu0 (chu0 R) Sa

/-- The seven sizes at node `u0`. -/
def wu0 : Letter → Nat
  | .B => 450159877464
  | .N => 449631429296
  | .A => 528417520
  | .D => 352237488
  | .O => 0
  | .H => 352237488
  | .V => 352298776

/-- Node `u0` has the sizes `wu0`. -/
lemma stepu0 (R : Realisation Letter Letter.sep G) (h : ∀ a, R.w a = w0 a) :
    ∀ a, (Ru0 R).w a = wu0 a := by
  intro a
  change (Realisation.multiSubst eu0 (chu0 R) Sa).w a = wu0 a
  rw [w_multiSubst]
  have h0 : ∀ b, (chu0 R 0).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  have h1 : ∀ b, (chu0 R 1).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  have h2 : ∀ b, (chu0 R 2).w b = w0 b := fun b => (w_R1 R b).trans (h b)
  simp only [Fin.prod_univ_three, h0, h1, h2]
  cases a <;> native_decide

