/-! ### The bound -/

/-- The exponents of the 4 terminal children. -/
def eT : Fin 4 → Nat := Fin.cases 741 (Fin.cases 741 (Fin.cases 741 (fun _ => 741)))

/-- The terminal children. -/
def terminalChildren (R : Realisation Letter Letter.sep G) :
    (i : Fin 4) → Realisation Letter Letter.sep (SimpleGraph.strongPower G (eT i)) :=
  Fin.cases (Ru15 R) (Fin.cases (Ru15 R) (Fin.cases (Ru15 R) (fun _ => (Ru15 R))))

/-- **The bound.**  A port system whose seven families have the sizes of `w0` gives an
independent set of size `M` in `G^(box 2964)`. -/
theorem bound (S : RichPortSystem G) (hw : ∀ a, (S.fam a).card = w0 a) :
    M ≤ (SimpleGraph.strongPower G 2964).indepNum := by
  have base_w : ∀ a, S.toRealisation.w a = w0 a := hw
  refine le_trans (le_of_eq ?_) (le_indepNum_multiCode eT (terminalChildren S.toRealisation) K)
  have h0 : ∀ a, (terminalChildren S.toRealisation 0).w a = wu15 a := by
    intro a; change (Ru15 S.toRealisation).w a = wu15 a; exact stepu15 S.toRealisation base_w a
  have h1 : ∀ a, (terminalChildren S.toRealisation 1).w a = wu15 a := by
    intro a; change (Ru15 S.toRealisation).w a = wu15 a; exact stepu15 S.toRealisation base_w a
  have h2 : ∀ a, (terminalChildren S.toRealisation 2).w a = wu15 a := by
    intro a; change (Ru15 S.toRealisation).w a = wu15 a; exact stepu15 S.toRealisation base_w a
  have h3 : ∀ a, (terminalChildren S.toRealisation 3).w a = wu15 a := by
    intro a; change (Ru15 S.toRealisation).w a = wu15 a; exact stepu15 S.toRealisation base_w a
  simp only [Fin.prod_univ_four, h0, h1, h2, h3]
  native_decide

