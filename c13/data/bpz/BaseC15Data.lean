/-
# Base data for `C15^(box 4)`

Words of `C15^4` are encoded as their base-15 code in `Fin 50625`; coordinate `k` is
`(n / 15^k) % 15`.  Conflict in `C15` is `sconf` and conflict in the strong 4th power
is `wconf` (conflict in *every* coordinate), so `G4` is `C15^(box 4)` by definition;
`CycleC15.lean` proves this for an explicitly constructed 15-cycle.

The independent set of size 2842 in `C15^(box 4)` is due to De Boer, Buys and
Zuiddam.  See the paper.

## The data

* `Iraw` -- an independent set of size 2842 in `C15^(box 4)`.
* `Xraw` -- the auxiliary set `X`, the translate `X = I + (0,-1,0,0)`.  Translation is
  a graph automorphism, so `X` is again an independent set of the same size.  Its two
  footprints are disjoint, with `|X_0| = 6` and `|X_1| = 3` (`BaseC15.base_Xc_false`,
  `BaseC15.base_Xc_true`), which is what admits `d = 3`.
* `pairsRaw` -- the 3 private pairs `(parent, alternative, side)`.  Each alternative
  has exactly one conflict inside `I`, and that is its parent.  3 of the 3 pairs have
  `side = true`.

Parameters: `(N, d, L, eta) = (2842, 3, 2842, 2833)`, footprints
`|X_0| = 6`, `|X_1| = 3`, so `c = 9` and `eta = 2842 - 6 - 3 = 2833`.

## The independence certificate

Independence is certified by checking each word's 81 closed cyclic neighbours against
the membership mask `maskI` (`IsubCheck`, `InbrCheck`); sortedness (`IsortCheck`)
supplies `Nodup`.
-/
import ShannonBounds.Lift

set_option maxRecDepth 4000000
set_option maxHeartbeats 0

namespace ShannonBounds
namespace BaseC15

/-- Words of `C15^4`, encoded in base 15. -/
abbrev Code := Fin 50625

/-! ### The coordinate conflict test -/

/-- **Reference spec** for conflict in `C15`: `(a - b) mod 15` is `0`, `1` or `14`. -/
def sconfSpec (a b : Nat) : Bool :=
  ((a + 15 - b) % 15 == 0) || ((a + 15 - b) % 15 == 1) || ((a + 15 - b) % 15 == 14)

/-- Equivalently: `{0,1,14}` shifted up by one mod 15 is `{x | x <= 2}`. -/
def sconf (a b : Nat) : Bool := (a + 16 - b) % 15 <= 2

theorem sconf_eq_spec : ∀ a < 15, ∀ b < 15, sconf a b = sconfSpec a b := by native_decide
theorem sconf_symm : ∀ a < 15, ∀ b < 15, sconf a b = sconf b a := by native_decide
theorem sconf_refl : ∀ a < 15, sconf a a = true := by native_decide

/-- The three admissible cyclic offsets, as residues mod 15. -/
def ds : List Nat := [14, 0, 1]

/-- `sconf` really does mean "differs by one of the three offsets". -/
theorem sconf_cases : ∀ a < 15, ∀ b < 15,
    sconf a b = true → ds.any (fun i => b == (a + i) % 15) = true := by native_decide

/-! ### Conflict in `C15^(box 4)` -/

/-- Conflict on raw codes: conflict in every one of the four coordinates. -/
def wconfN (u v : Nat) : Bool :=
  sconf (u / 1 % 15) (v / 1 % 15) && sconf (u / 15 % 15) (v / 15 % 15) &&
    sconf (u / 225 % 15) (v / 225 % 15) && sconf (u / 3375 % 15) (v / 3375 % 15)

/-- Coordinate `k` of a code, as a `Nat`, for `m = 15^k`. -/
def dgt (m : Nat) (u : Code) : Nat := u.val / m % 15

lemma dgt_lt (m : Nat) (u : Code) : dgt m u < 15 := Nat.mod_lt _ (by decide)

def wconf (u v : Code) : Bool := wconfN u.val v.val

lemma wconf_eq (u v : Code) :
    wconf u v = (sconf (dgt 1 u) (dgt 1 v) && sconf (dgt 15 u) (dgt 15 v) &&
      sconf (dgt 225 u) (dgt 225 v) && sconf (dgt 3375 u) (dgt 3375 v)) := rfl

lemma wconf_symm (u v : Code) : wconf u v = wconf v u := by
  rw [wconf_eq, wconf_eq,
    sconf_symm (dgt 1 u) (dgt_lt 1 u) (dgt 1 v) (dgt_lt 1 v),
    sconf_symm (dgt 15 u) (dgt_lt 15 u) (dgt 15 v) (dgt_lt 15 v),
    sconf_symm (dgt 225 u) (dgt_lt 225 u) (dgt 225 v) (dgt_lt 225 v),
    sconf_symm (dgt 3375 u) (dgt_lt 3375 u) (dgt 3375 v) (dgt_lt 3375 v)]

lemma wconf_refl (u : Code) : wconf u u = true := by
  rw [wconf_eq, sconf_refl (dgt 1 u) (dgt_lt 1 u), sconf_refl (dgt 15 u) (dgt_lt 15 u),
    sconf_refl (dgt 225 u) (dgt_lt 225 u), sconf_refl (dgt 3375 u) (dgt_lt 3375 u)]
  rfl

/-- `C15^(box 4)`. -/
def G4 : SimpleGraph Code where
  Adj u v := u ≠ v ∧ wconf u v = true
  symm := ⟨by
    intro u v h
    exact ⟨h.1.symm, by rw [wconf_symm]; exact h.2⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

instance decG4 : DecidableRel G4.Adj := fun u v =>
  inferInstanceAs (Decidable (u ≠ v ∧ wconf u v = true))

lemma conflict_G4 (u v : Code) : conflict G4 u v ↔ wconf u v = true := by
  constructor
  · rintro (rfl | ⟨-, h⟩)
    · exact wconf_refl u
    · exact h
  · intro h
    by_cases huv : u = v
    · exact Or.inl huv
    · exact Or.inr ⟨huv, h⟩

/-! ### Digit reconstruction and the 81 neighbours -/

/-- A code below `50625` is recovered from its four base-15 digits. -/
theorem recon (v : Nat) (h : v < 50625) :
    ((v / 3375 % 15 * 15 + v / 225 % 15) * 15 + v / 15 % 15) * 15 + v / 1 % 15 = v := by
  omega

/-- The 81 closed cyclic neighbours of `u` in `Z_15^4`. -/
def nb (u : Nat) : List Nat :=
  ds.flatMap fun i => ds.flatMap fun j => ds.flatMap fun k => ds.map fun m =>
    ((((u / 3375 % 15 + i) % 15) * 15 + (u / 225 % 15 + j) % 15) * 15
      + (u / 15 % 15 + k) % 15) * 15 + (u / 1 % 15 + m) % 15

private lemma pick {a b : Nat} (ha : a < 15) (hb : b < 15) (h : sconf a b = true) :
    ∃ i ∈ ds, b = (a + i) % 15 := by
  obtain ⟨i, hi, he⟩ := List.any_eq_true.mp (sconf_cases a ha b hb h)
  exact ⟨i, hi, by simpa using he⟩

/-- **Conflict implies neighbour.**  This is the bridge that makes the 81-neighbour
certificate a proof of independence. -/
theorem mem_nb (u v : Nat) (hv : v < 50625) (h : wconfN u v = true) : v ∈ nb u := by
  simp only [wconfN, Bool.and_eq_true] at h
  obtain ⟨⟨⟨h0, h1⟩, h2⟩, h3⟩ := h
  obtain ⟨i0, hi0, e0⟩ := pick (Nat.mod_lt _ (by decide)) (Nat.mod_lt _ (by decide)) h0
  obtain ⟨i1, hi1, e1⟩ := pick (Nat.mod_lt _ (by decide)) (Nat.mod_lt _ (by decide)) h1
  obtain ⟨i2, hi2, e2⟩ := pick (Nat.mod_lt _ (by decide)) (Nat.mod_lt _ (by decide)) h2
  obtain ⟨i3, hi3, e3⟩ := pick (Nat.mod_lt _ (by decide)) (Nat.mod_lt _ (by decide)) h3
  refine List.mem_flatMap.mpr ⟨i3, hi3, ?_⟩
  refine List.mem_flatMap.mpr ⟨i2, hi2, ?_⟩
  refine List.mem_flatMap.mpr ⟨i1, hi1, ?_⟩
  refine List.mem_map.mpr ⟨i0, hi0, ?_⟩
  rw [← e3, ← e2, ← e1, ← e0]
  exact recon v hv

/-! ### Strict sortedness gives `Nodup` in linear time -/

def ssorted : List Nat → Bool
  | [] => true
  | [_] => true
  | a :: b :: t => (a < b) && ssorted (b :: t)

theorem ssorted_pairwise : ∀ {l : List Nat}, ssorted l = true → l.Pairwise (· < ·) := by
  intro l
  induction l with
  | nil => intro _; exact List.Pairwise.nil
  | cons a t ih =>
      cases t with
      | nil => intro _; simp
      | cons b t' =>
          intro h
          simp only [ssorted, Bool.and_eq_true, decide_eq_true_eq] at h
          have hp := ih h.2
          refine List.Pairwise.cons ?_ hp
          intro c hc
          rcases List.mem_cons.mp hc with rfl | hc'
          · exact h.1
          · exact lt_trans h.1 (List.rel_of_pairwise_cons hp hc')

theorem ssorted_nodup {l : List Nat} (h : ssorted l = true) : l.Nodup :=
  (ssorted_pairwise h).imp Nat.ne_of_lt

/-! ### The bitmask membership test -/

/-- `memb M u` is bit `u` of the bitmask `M`: it says whether `u` lies in the set that
`M` encodes. -/
def memb (M u : Nat) : Bool := ((M >>> u) &&& 1) == 1

/-! ### Raw `Nat` data lifted to `Code` -/

def toCode (u : Nat) : Code := ⟨u % 50625, Nat.mod_lt _ (by decide)⟩

theorem toCode_val {u : Nat} (h : u < 50625) : (toCode u).val = u := Nat.mod_eq_of_lt h

theorem mem_map_toCode {raw : List Nat} (hb : ∀ u ∈ raw, u < 50625) (x : Code) :
    x ∈ raw.map toCode ↔ x.val ∈ raw := by
  constructor
  · intro hx
    obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hx
    rwa [toCode_val (hb u hu)]
  · intro hx
    exact List.mem_map.mpr ⟨x.val, hx, by apply Fin.ext; exact toCode_val x.isLt⟩

theorem nodup_map_toCode {raw : List Nat} (hb : ∀ u ∈ raw, u < 50625)
    (hn : raw.Nodup) : (raw.map toCode).Nodup := by
  refine List.Nodup.map_on ?_ hn
  intro a ha b hb' hab
  have := congrArg Fin.val hab
  rwa [toCode_val (hb a ha), toCode_val (hb b hb')] at this

/-- **Independence from the mask certificate.** -/
theorem indep_of_mask {raw : List Nat} {M : Nat}
    (hb : ∀ u ∈ raw, u < 50625)
    (hsub : ∀ u ∈ raw, memb M u = true)
    (hnbr : ∀ u ∈ raw, ∀ w ∈ nb u, w = u ∨ memb M w = false)
    (nd : ((raw.map toCode : List Code) : Multiset Code).Nodup) :
    G4.IsIndepSet ((⟨((raw.map toCode : List Code) : Multiset Code), nd⟩ : Finset Code) :
      Set Code) := by
  intro x hx y hy hne hadj
  rw [Finset.mem_coe, Finset.mem_mk, Multiset.mem_coe, mem_map_toCode hb] at hx hy
  have hw : wconfN x.val y.val = true := hadj.2
  have hmem : y.val ∈ nb x.val := mem_nb x.val y.val y.isLt hw
  rcases hnbr x.val hx y.val hmem with heq | hfalse
  · exact hne (Fin.val_injective heq).symm
  · rw [hsub y.val hy] at hfalse
    exact Bool.noConfusion hfalse

